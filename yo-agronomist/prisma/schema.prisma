generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FarmerType {
  SMALLHOLDER
  COMMERCIAL
}

enum ChannelType {
  SMS
  WHATSAPP
  APP
}

enum AlertType {
  PLANTING
  PEST
  WEATHER
  MARKET
  IRRIGATION
  FERTILIZER
  HARVEST
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum CropKey {
  MAIZE
  BEANS
  BANANA
  COFFEE
  TOMATO
}

enum SubscriptionPlan {
  FREE
  PREMIUM
}

enum AdvisorySource {
  RULE_ENGINE
  AI_ASSISTANT
  HYBRID
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String?  @unique
  passwordHash String?
  role         String   @default("admin")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Farmer {
  id               String            @id @default(cuid())
  farmerCode       String            @unique
  fullName         String
  phoneNumber      String            @unique
  region           String
  district         String
  farmerType       FarmerType
  preferredChannel ChannelType
  language         String            @default("English")
  farmSizeAcres    Float?
  soilType         String?
  subscriptionPlan SubscriptionPlan  @default(FREE)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  cropInterests    FarmerCrop[]
  farmProfiles     FarmProfile[]
  advisories       AdvisoryLog[]
  alerts           FarmerAlert[]
  messages         MessageLog[]
}

model FarmProfile {
  id               String      @id @default(cuid())
  farmerId         String
  name             String?
  district         String
  acreage          Float?
  soilType         String?
  irrigationAccess Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  farmer           Farmer      @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  seasons          SeasonPlan[]
}

model FarmerCrop {
  id        String   @id @default(cuid())
  farmerId  String
  crop      CropKey
  priority  Int      @default(1)
  createdAt DateTime @default(now())
  farmer    Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  @@unique([farmerId, crop])
}

model SeasonPlan {
  id                String      @id @default(cuid())
  farmProfileId     String
  crop              CropKey
  seasonName        String
  targetPlantingAt  DateTime?
  expectedHarvestAt DateTime?
  seedVariety       String?
  status            String      @default("planned")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  farmProfile       FarmProfile @relation(fields: [farmProfileId], references: [id], onDelete: Cascade)
}

model WeatherSnapshot {
  id              String   @id @default(cuid())
  district        String
  forecastDate    DateTime
  rainfallMm      Float?
  temperatureMinC Float?
  temperatureMaxC Float?
  humidityPct     Float?
  onsetSignal     Boolean  @default(false)
  drySpellRisk    Boolean  @default(false)
  source          String
  createdAt       DateTime @default(now())
}

model PestObservation {
  id         String   @id @default(cuid())
  district   String
  crop       CropKey
  pestName   String
  riskLevel  String
  note       String?
  observedAt DateTime
  source     String?
  createdAt  DateTime @default(now())
}

model MarketPrice {
  id          String   @id @default(cuid())
  district    String
  crop        CropKey
  marketName  String?
  unit        String
  price       Float
  currency    String   @default("UGX")
  collectedAt DateTime
  source      String?
  createdAt   DateTime @default(now())
}

model AdvisoryLog {
  id             String         @id @default(cuid())
  farmerId       String?
  district       String
  crop           CropKey
  question       String?
  plantingWindow String?
  advisoryText   String
  confidence     String?
  source         AdvisorySource
  rawInputs      Json?
  rawOutputs     Json?
  createdAt      DateTime       @default(now())
  farmer         Farmer?        @relation(fields: [farmerId], references: [id], onDelete: SetNull)
}

model AlertRule {
  id           String    @id @default(cuid())
  name         String
  alertType    AlertType
  crop         CropKey?
  district     String?
  triggerLogic Json
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model FarmerAlert {
  id          String        @id @default(cuid())
  farmerId    String
  alertType   AlertType
  title       String
  message     String
  channel     ChannelType
  status      MessageStatus @default(QUEUED)
  scheduledAt DateTime?
  sentAt      DateTime?
  metadata    Json?
  createdAt   DateTime      @default(now())
  farmer      Farmer        @relation(fields: [farmerId], references: [id], onDelete: Cascade)
}

model MessageLog {
  id                String           @id @default(cuid())
  farmerId          String?
  channel           ChannelType
  direction         MessageDirection
  phoneNumber       String?
  content           String
  provider          String?
  providerMessageId String?
  status            MessageStatus    @default(QUEUED)
  metadata          Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  farmer            Farmer?          @relation(fields: [farmerId], references: [id], onDelete: SetNull)
}

model KnowledgeDocument {
  id        String   @id @default(cuid())
  title     String
  category  String
  crop      CropKey?
  district  String?
  language  String   @default("English")
  content   String
  source    String?
  version   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  details     Json?
  createdAt   DateTime @default(now())
}
